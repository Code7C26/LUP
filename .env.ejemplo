# ==========================================================
#  Lüp · Configuración local
#  1) Copiá este archivo con el nombre ".env" (en la raíz del proyecto).
#  2) Completá los valores. El .env NO se sube a GitHub.
# ==========================================================

# --- Gmail: avisos a los comercios ---
# Cuenta de Gmail desde la que salen los avisos (ej: lup.avisos@gmail.com)
GMAIL_USUARIO=
# "Contraseña de aplicación" de 16 letras (NO la contraseña normal de Gmail).
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
GMAIL_CLAVE_APP=

# Dirección del sitio para los links de los emails
SITIO_URL=http://127.0.0.1:8000

# --- Google Maps (opcional) ---
# Sin clave, los mapas y "Cómo llegar" funcionan igual.
# Con clave (Maps Embed API + Geocoding API) se usan los mapas oficiales y
# se ubica automáticamente a cada comercio a partir de su dirección.
GOOGLE_MAPS_API_KEY=
