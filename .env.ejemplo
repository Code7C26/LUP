# ==========================================================
#  Lüp · Configuración local
#  1) Copiá este archivo con el nombre ".env" (en la raíz del proyecto).
#  2) Completá los valores. El .env NO se sube a GitHub.
# ==========================================================

# --- Gmail: avisos a los comercios ---
# Cuenta de Gmail desde la que salen los avisos (ej: lup.avisos@gmail.com)
GMAIL_USUARIO=
# "Contraseña de aplicación" de 16 letras (NO la contraseña normal de Gmail).
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
GMAIL_CLAVE_APP=

# Dirección del sitio para los links de los emails
SITIO_URL=http://127.0.0.1:8000

# --- Google Maps (opcional) ---
# Sin clave, los mapas y "Cómo llegar" funcionan igual.
# Con clave (Maps Embed API + Geocoding API) se usan los mapas oficiales y
# se ubica automáticamente a cada comercio a partir de su dirección.
GOOGLE_MAPS_API_KEY=

# --- Asistente de soporte con IA (opcional) ---
# Clave de la API de Anthropic (https://console.anthropic.com > API Keys).
# Sin clave, el chat de ayuda responde con preguntas frecuentes.
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-haiku-5-5, el más rápido y barato)
SOPORTE_MODELO=claude-haiku-5-5
# Email que recibe los pedidos de "Hablar con una persona" (si se deja vacío, GMAIL_USUARIO)
SOPORTE_EMAIL=

# --- Solo para la página publicada (en Render se cargan en "Environment", no en este archivo) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=una_clave_larga_y_secreta
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/base
# DJANGO_ALLOWED_HOSTS=lupalimentos.com,www.lupalimentos.com
# MEDIA_ROOT=/var/data/media
# RECORDATORIOS_HORA=9
