{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_URL_SERVIDOR": "https://www.lupalimentos.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_URL_SERVIDOR": "https://www.lupalimentos.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
