{
  "expo": {
    "name": "Lüp",
    "slug": "lup",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/659308e2-51d2-42c2-838e-3d7ef9a45e98"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ar.com.lup",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#B6D1A1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-claro.png",
            "backgroundColor": "#0E1713"
          }
        }
      ],
      "expo-status-bar",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#073425"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lüp usa la cámara para escanear el código QR de los retiros y sacar fotos de los productos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lüp usa tus fotos para que elijas la imagen de un producto o de tu perfil.",
          "cameraPermission": "Lüp usa la cámara para sacar fotos de los productos y de tu perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lüp usa tu ubicación para mostrarte los comercios y las ofertas más cerca tuyo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "659308e2-51d2-42c2-838e-3d7ef9a45e98"
      }
    },
    "owner": "ssofias-team"
  }
}
